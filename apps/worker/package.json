{
  "name": "@florence/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run --config ../../vitest.config.ts src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@florence/artifacts": "workspace:*",
    "@florence/contracts": "workspace:*",
    "@florence/control-plane": "workspace:*",
    "@florence/database": "workspace:*",
    "@florence/google": "workspace:*",
    "@florence/linq": "workspace:*",
    "@florence/runtime": "workspace:*"
  }
}
