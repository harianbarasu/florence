# Runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
FLORENCE_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/florence
FLORENCE_DB_SCHEMA=florence
FLORENCE_WEB_BASE_URL=http://localhost:3000
FLORENCE_TOKEN_ENCRYPTION_KEY=
FLORENCE_ADMIN_API_KEY=
FLORENCE_DEFAULT_TIMEZONE=America/Los_Angeles

# Linq
LINQ_API_KEY=
LINQ_BASE_URL=https://api.linqapp.com/api/partner/v3
LINQ_FROM_PHONE=
LINQ_WEBHOOK_SECRET=

# Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_STATE_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/google/callback
GOOGLE_PUBSUB_VERIFICATION_TOKEN=

# Models
MODEL_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-terra
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPEN_WEIGHT_BASE_URL=
OPEN_WEIGHT_API_KEY=
OPEN_WEIGHT_MODEL=

# Worker
WORKER_POLL_INTERVAL_MS=1000
WORKER_LEASE_SECONDS=60
DAILY_BRIEF_LOCAL_TIME=06:30
