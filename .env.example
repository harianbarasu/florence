# Florence runtime
# Use Postgres for deployed pilots. Leave empty only for local SQLite fallback.
FLORENCE_DATABASE_URL=postgresql://florence:florence@db:5432/florence
FLORENCE_DB_PATH=./data/florence.sqlite
FLORENCE_DEFAULT_TIMEZONE=America/Los_Angeles
FLORENCE_DAILY_BRIEFING_HOUR=7
FLORENCE_DAILY_BRIEFING_MINUTE=15
FLORENCE_DAILY_BRIEFING_DELIVERY_GRACE_MINUTES=240
FLORENCE_REMINDER_DELIVERY_GRACE_MINUTES=1440
FLORENCE_PENDING_ACTION_TTL_MINUTES=1440
FLORENCE_DATA_DELETION_CONFIRMATION_TTL_MINUTES=30
FLORENCE_DEV_ENDPOINTS_ENABLED=1
FLORENCE_ADMIN_API_KEY=
FLORENCE_SOURCE_INGEST_API_KEY=
FLORENCE_TOKEN_ENCRYPTION_KEY=
FLORENCE_SUPPORT_CONTACT=support@example.com
FLORENCE_WEB_BASE_URL=https://your-florence-domain.example.com
FLORENCE_ONBOARDING_STATE_SECRET=
FLORENCE_ONBOARDING_TOKEN_TTL_HOURS=336
# Optional deploy-time fallback. Prefer database proof via /dev/live-verifications.
# Set these to 1 only after the staging smoke checklist has exercised live services.
FLORENCE_LINQ_LIVE_VERIFIED=0
FLORENCE_LINQ_LIVE_VERIFIED_AT=
FLORENCE_LINQ_LIVE_VERIFICATION_PROOF=
FLORENCE_GOOGLE_LIVE_VERIFIED=0
FLORENCE_GOOGLE_LIVE_VERIFIED_AT=
FLORENCE_GOOGLE_LIVE_VERIFICATION_PROOF=
FLORENCE_HERMES_LIVE_VERIFIED=0
FLORENCE_HERMES_LIVE_VERIFIED_AT=
FLORENCE_HERMES_LIVE_VERIFICATION_PROOF=

# Linq transport
LINQ_API_KEY=
LINQ_WEBHOOK_SECRET=
LINQ_BASE_URL=https://api.linqapp.com/api/partner/v3
LINQ_FROM_PHONE=

# Google connected sources
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/oauth/google/callback
GOOGLE_OAUTH_SCOPES=openid,email,https://www.googleapis.com/auth/gmail.readonly,https://www.googleapis.com/auth/calendar.readonly
GOOGLE_OAUTH_STATE_TTL_MINUTES=15
GOOGLE_FETCH_SINCE_DAYS=7
GOOGLE_FETCH_CALENDAR_DAYS=14
GOOGLE_FETCH_MAX_EMAILS=25
GOOGLE_FETCH_MAX_CALENDAR_EVENTS=50
FLORENCE_SOURCE_SYNC_INTERVAL_SECONDS=300

# Hermes Agent backend
# Docker live Hermes: keep INSTALL_HERMES_AGENT=1, pin HERMES_AGENT_REF to a
# full 40-character SHA-1 or 64-character SHA-256 commit id, and keep
# FLORENCE_HERMES_AGENT_PATH=/opt/hermes-agent.
# Docker builds and pilot preflight block until HERMES_AGENT_REF and
# FLORENCE_HERMES_MODEL are replaced with real values.
# Local dev without Docker: point FLORENCE_HERMES_AGENT_PATH at your local clone.
INSTALL_HERMES_AGENT=1
HERMES_AGENT_REPO=https://github.com/NousResearch/hermes-agent.git
HERMES_AGENT_REF=
FLORENCE_HERMES_AGENT_PATH=/opt/hermes-agent
FLORENCE_HERMES_PROVIDER=openrouter
FLORENCE_HERMES_MODEL=
# Keep Hermes toolsets empty for SaaS pilots; Florence owns tenant-scoped tools.
FLORENCE_HERMES_TOOLSETS=
# Base for per-turn Hermes scratch homes; keep it out of shared ~/.hermes.
FLORENCE_HERMES_RUNTIME_HOME=/tmp/florence-hermes-home
# Keep strict on for SaaS pilots so Hermes contract failures are visible.
FLORENCE_HERMES_STRICT=1
