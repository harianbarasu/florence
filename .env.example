# Runtime
NODE_ENV=development
FLORENCE_PROCESS_ROLE=all
PORT=3000
LOG_LEVEL=info
FLORENCE_DATABASE_URL=postgres://florence:florence@127.0.0.1:5432/florence
FLORENCE_POSTGRES_SCHEMA=florence
FLORENCE_WEB_BASE_URL=http://localhost:3000
FLORENCE_TOKEN_ENCRYPTION_KEY=
FLORENCE_DATA_ACTIVE_KEY_ID=
FLORENCE_DATA_KEYRING_JSON=
FLORENCE_BLIND_INDEX_KEY=
FLORENCE_ADMIN_API_KEY=
FLORENCE_DEFAULT_TIMEZONE=America/Los_Angeles

# Linq
LINQ_API_KEY=
LINQ_BASE_URL=https://api.linqapp.com/api/partner/v3
LINQ_FROM_PHONE=
LINQ_WEBHOOK_SECRET=

# Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_STATE_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_PUBSUB_VERIFICATION_TOKEN=
GOOGLE_PUBSUB_OIDC_AUDIENCE=
GOOGLE_PUBSUB_SERVICE_ACCOUNT_EMAIL=
GOOGLE_GMAIL_TOPIC_NAME=
GOOGLE_GMAIL_PUBSUB_SUBSCRIPTION=

# Models
MODEL_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-terra
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPEN_WEIGHT_BASE_URL=
OPEN_WEIGHT_API_KEY=
OPEN_WEIGHT_MODEL=

# Worker
WORKER_POLL_INTERVAL_MS=1000
WORKER_LEASE_SECONDS=60
DAILY_BRIEF_LOCAL_TIME=06:30
