# --- Storage -----------------------------------------------------------------
# Postgres only. Local default matches docker-compose (port 5433).
FLORENCE_DATABASE_URL=postgresql://florence:florence@localhost:5433/florence
FLORENCE_DB_SCHEMA=florence_v3

# --- Identity / web -------------------------------------------------------------
FLORENCE_WEB_BASE_URL=http://localhost:8000
FLORENCE_ADMIN_API_KEY=
FLORENCE_SUPPORT_CONTACT=
FLORENCE_DEFAULT_TIMEZONE=America/Los_Angeles

# --- Model (any OpenAI-compatible chat-completions endpoint) ---------------------
# OpenAI:      FLORENCE_MODEL=gpt-5.5            (base url default)
# Nous Portal: FLORENCE_MODEL=<portal model id>  FLORENCE_MODEL_BASE_URL=<portal url>
# OpenRouter:  FLORENCE_MODEL=<vendor/model>     FLORENCE_MODEL_BASE_URL=https://openrouter.ai/api/v1
FLORENCE_MODEL=gpt-5.5
FLORENCE_MODEL_BASE_URL=https://api.openai.com/v1
FLORENCE_MODEL_API_KEY=
# Optional, for reasoning models: low | medium | high
FLORENCE_REASONING_EFFORT=

# --- Linq (iMessage transport) ----------------------------------------------------
# Leave LINQ_API_KEY empty for dry-run mode (sends are logged, not delivered).
LINQ_API_KEY=
LINQ_BASE_URL=https://api.linqapp.com/api/partner/v3
LINQ_WEBHOOK_SECRET=
LINQ_FROM_PHONE=

# --- Google (Gmail + Calendar, read-only) ----------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/oauth/google/callback
# Fernet key for encrypting OAuth tokens at rest:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FLORENCE_TOKEN_ENCRYPTION_KEY=

# --- Rhythms (defaults are sensible; override only if needed) ----------------------
# FLORENCE_BRIEF_HOUR=7
# FLORENCE_BRIEF_MINUTE=15
# FLORENCE_DEBOUNCE_SECONDS=2.5
# FLORENCE_SCHEDULER_INTERVAL_SECONDS=20
# FLORENCE_GMAIL_SYNC_INTERVAL_SECONDS=300
