NODE_ENV=development
PORT=3000
LOG_LEVEL=info

FLORENCE_DATABASE_URL=postgres://florence:florence@localhost:5432/florence
FLORENCE_POSTGRES_SCHEMA=florence_v4
FLORENCE_WEB_BASE_URL=http://localhost:3000

# JSON array of exactly two {token,adultId,householdIds} records, one per pilot adult.
FLORENCE_PILOT_CREDENTIALS=[]
FLORENCE_SESSION_SECRET=
FLORENCE_ENROLLMENT_SECRET=

# Canonical base64-encoded 32-byte key. Encrypted image envelopes live in PostgreSQL.
FLORENCE_IMAGE_VAULT_KEY=
FLORENCE_IMAGE_RETENTION_DAYS=30

LINQ_API_KEY=
LINQ_WEBHOOK_SECRET=
LINQ_PARTNER_ID=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CREDENTIAL_KEY=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
FLORENCE_MODEL_TIMEOUT_MS=30000
FLORENCE_MODEL_MAX_OUTPUT_TOKENS=4000

# Optional browser development override. Production is same-origin.
VITE_API_BASE_URL=

# PostgreSQL integration tests are opt-in and must use a disposable database/schema.
FLORENCE_TEST_DATABASE_URL=
FLORENCE_TEST_POSTGRES_SCHEMA=florence_test
