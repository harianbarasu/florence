{
  "name": "florence",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10.10 <11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:migrate": "tsx --env-file-if-exists=.env src/cli/migrate.ts",
    "dev": "tsx --env-file-if-exists=.env watch src/server.ts",
    "dev:worker": "tsx --env-file-if-exists=.env watch src/worker.ts",
    "format": "biome format --write .",
    "lint": "biome check .",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/helmet": "13.1.0",
    "@fastify/rate-limit": "11.2.0",
    "@js-temporal/polyfill": "0.5.1",
    "@langchain/anthropic": "1.5.3",
    "@langchain/core": "1.2.4",
    "@langchain/langgraph": "1.4.9",
    "@langchain/langgraph-checkpoint": "1.1.3",
    "@langchain/langgraph-sdk": "1.9.28",
    "@langchain/openai": "1.5.5",
    "deepagents": "1.12.2",
    "fastify": "5.11.2",
    "fastify-raw-body": "5.0.0",
    "google-auth-library": "10.5.0",
    "googleapis": "174.0.0",
    "langchain": "1.5.4",
    "langsmith": "0.7.17",
    "pino": "10.3.1",
    "postgres": "3.4.9",
    "prom-client": "15.1.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@types/node": "26.1.2",
    "tsx": "4.23.7",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
